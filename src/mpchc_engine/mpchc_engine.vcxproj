<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B8D3D24A-7D8A-4E5D-9F35-0D3B3E0E4B1A}</ProjectGuid>
    <RootNamespace>mpchc_engine</RootNamespace>
    <Keyword>MFCProj</Keyword>
    <ProjectName>mpchc_engine</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="..\platform.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseOfMfc>Static</UseOfMfc>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="..\common.props" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!-- Explicit, because the subtitle stack (Subtitles.lib, SubPic.lib, DSUtil.lib)
           is MFC-static on the STATIC CRT (nafxcw) via common.props, and a TU that
           touches MFC on the DLL CRT asks for uafxcw instead — the two static-MFC
           variants collide symbol-for-symbol at link. One flavour across the chain. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalIncludeDirectories>..\..\include;..\thirdparty;..\thirdparty\BaseClasses;$(ML_MPCVR_INCLUDE);$(LAV_INCLUDE);$(DECKLINK_INCLUDE);..\mpc-hc;..\DSUtil;..\SubPic;..\Subtitles;..\filters;..\filters\renderer;..\filters\renderer\VideoRenderers;..\thirdparty\freetype2\freetype2\include;..\thirdparty\libass\libass\include;..\thirdparty\fribidi\generated;..\thirdparty\LAVFilters\src\common\includes;..\thirdparty\ResizableLib\ResizableLib;..\thirdparty\AudioTools;..\thirdparty\MediaInfo\library\Source;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="MpcPlayer.cpp" />
    <ClCompile Include="DeckLinkMonitor.cpp" />
    <ClCompile Include="IngestController.cpp" />
    <!-- MPC-HC's internal subtitle path, hosted by the engine. Each file finds its own
         directory's stdafx.h via the quoted include, exactly as it does inside
         mpc-hc.exe; nothing here is a copy, so the filter behaviour cannot drift from
         the player's. -->
    <ClCompile Include="..\mpc-hc\TextPassThruFilter.cpp" />
    <ClCompile Include="..\DSUtil\NullRenderers.cpp" />
    <ClCompile Include="..\filters\renderer\VideoRenderers\MPCVRAllocatorPresenter.cpp" />
    <ClCompile Include="..\filters\renderer\VideoRenderers\RenderersSettings.cpp" />
    <ClCompile Include="..\filters\renderer\VideoRenderers\IPinHook.cpp" />
    <ClCompile Include="SubtitlePlayerGlobals.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="MpcPlayer.h" />
    <ClInclude Include="DeckLinkMonitor.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>

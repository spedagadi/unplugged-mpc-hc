// Unplugged.rc -- the app's own identity: the 1.3.0 icon and version resource.
//
// Both are what Explorer and the taskbar read BEFORE the process runs, so they
// must live in the executable. The icon is the same file 1.3.0 shipped
// (assets\brand\ico\unplugged.ico), which is the point: an upgrade must not
// change what the user sees in the taskbar or the Start menu.
#include <windows.h>

#define IDI_APP 101

IDI_APP ICON "..\\..\\src\\unplugged-ui\\assets\\brand\\ico\\unplugged.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "unplugged"
            VALUE "FileDescription",  "Unplugged"
            VALUE "FileVersion",      "2.1.0.0"
            VALUE "InternalName",     "Unplugged"
            VALUE "OriginalFilename", "Unplugged.exe"
            VALUE "ProductName",      "Unplugged"
            VALUE "ProductVersion",   "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END